#!/usr/bin/env bash

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG="$(dirname "$SCRIPT_DIR")"

if [ ! -d "$CONFIG/.git" ]; then
    printf 'niselle: not a git checkout: %s\n' "$CONFIG" >&2
    exit 1
fi

if ! command -v git >/dev/null 2>&1; then
    printf 'niselle: git is not installed\n' >&2
    exit 1
fi

BRANCH="$(git -C "$CONFIG" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
printf 'niselle: pulling latest commit (origin/%s) …\n' "$BRANCH"

if ! out="$(git -C "$CONFIG" pull --ff-only origin "$BRANCH" 2>&1)"; then
    printf 'niselle: %s\n' "$(printf '%s' "$out" | tail -n1)" >&2
    exit 1
fi

case "$out" in
    *"Already up to date"*|*"Already up-to-date"*)
        printf 'niselle: already up to date\n' ;;
    *)
        printf 'niselle: %s\n' "$(printf '%s' "$out" | tail -n1)" ;;
esac

printf 'niselle: restarting the shell …\n'

if command -v setsid >/dev/null 2>&1; then
    setsid -f "$CONFIG/bin/niselle" restart >/dev/null 2>&1
else
    "$CONFIG/bin/niselle" restart >/dev/null 2>&1 &
fi

exit 0
