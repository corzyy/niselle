#!/usr/bin/env python3
# Spektrum des Systemtons für die Audio-Visualisierung der Menüleiste (modules/topbar/AudioVisualizer.qml).
# Liest den Monitor des Standard-Ausgangs über parec (PulseAudio/PipeWire) und schreibt je Bild eine Zeile mit
# BANDS ganzen Zahlen von 0 bis 100 (Goertzel-Filter auf logarithmisch verteilten Frequenzen, ohne numpy).
# Aufruf: niselle-audio-bands [Bänder]   (Beenden mit SIGTERM; parec wird mitbeendet)
import array
import math
import signal
import subprocess
import sys

BANDS = int(sys.argv[1]) if len(sys.argv) > 1 else 12
RATE = 16000
WINDOW = 400  # 25 ms je Bild, 40 Bilder pro Sekunde
LOW, HIGH = 80.0, 7000.0

freqs = [LOW * (HIGH / LOW) ** (i / (BANDS - 1)) for i in range(BANDS)]
coeffs = [2 * math.cos(2 * math.pi * f / RATE) for f in freqs]
hann = [0.5 - 0.5 * math.cos(2 * math.pi * n / (WINDOW - 1)) for n in range(WINDOW)]
# höhere Bänder tragen weniger Energie (rosa Rauschen): leicht anheben
tilt = [i * 1.6 for i in range(BANDS)]

proc = subprocess.Popen(
    ["parec", "-d", "@DEFAULT_SINK@.monitor", "--format=s16le", f"--rate={RATE}", "--channels=1", "--latency-msec=25"],
    stdout=subprocess.PIPE,
    stderr=subprocess.DEVNULL,
)


def stop(*_):
    proc.terminate()
    sys.exit(0)


signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)

smooth = [0.0] * BANDS
need = WINDOW * 2
while True:
    data = proc.stdout.read(need)
    if len(data) < need:
        break
    samples = array.array("h", data)
    x = [s * w / 32768.0 for s, w in zip(samples, hann)]
    out = []
    for i, c in enumerate(coeffs):
        s1 = s2 = 0.0
        for v in x:
            s0 = v + c * s1 - s2
            s2 = s1
            s1 = s0
        power = s1 * s1 + s2 * s2 - c * s1 * s2
        db = 10 * math.log10(power / (WINDOW * WINDOW) + 1e-12) + tilt[i]
        level = max(0.0, min(1.0, (db + 78) / 48))
        # schneller Anstieg, langsames Abklingen
        smooth[i] = level if level > smooth[i] else smooth[i] * 0.8 + level * 0.2
        out.append(int(smooth[i] * 100))
    try:
        sys.stdout.write(" ".join(map(str, out)) + "\n")
        sys.stdout.flush()
    except BrokenPipeError:
        break
proc.terminate()
